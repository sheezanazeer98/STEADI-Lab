# ---------------------------------------------------------------------------
# STEADI Lab website — environment variables
# Copy to .env.local for development. On Vercel, add these in Project Settings.
# Variables prefixed NEXT_PUBLIC_ are embedded in the client bundle; never put
# secrets in them.
# ---------------------------------------------------------------------------

# Canonical site URL (no trailing slash). Used for metadata, sitemap, JSON-LD
# and the www/apex redirect. Defaults to https://steadi-lab.org.
NEXT_PUBLIC_SITE_URL=https://steadi-lab.org

# Development-only sample content. Defaults to "true" outside production builds
# and "false" in production. Set explicitly to override (e.g. "true" on a
# preview deployment to demonstrate the layouts).
# SHOW_SAMPLE_CONTENT=false

# --- Public contact details (leave blank until authorised) -------------------
# Shown on the contact page, in the footer and in structured data.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_SCHOLAR_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# --- Inquiry form delivery (server-only) ------------------------------------
# Messages from /contact and /collaborate are delivered with Resend
# (https://resend.com). When RESEND_API_KEY or CONTACT_TO_EMAIL is missing the
# form reports that delivery is not configured (in development the message is
# logged to the server console instead).
RESEND_API_KEY=
# One or more recipient addresses, comma-separated.
CONTACT_TO_EMAIL=
# Sender shown on delivered emails. Must be a verified Resend domain/sender.
CONTACT_FROM_EMAIL="STEADI Lab <noreply@steadi-lab.org>"
